rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is approved
    function isApprovedUser() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isApproved == true;
    }

    // Members can access every project; collaborators only the ones
    // they're listed on. This mirrors the client-side filter that already
    // existed in FirebaseProjectsService (getAllProjects/subscribeToProjects)
    // — moving it into the rules means it now actually holds against a
    // direct SDK/API call, not just through the app's own UI.
    function isMember() {
      return isApprovedUser() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'member';
    }

    function isCollaboratorOnProject(projectData) {
      return isApprovedUser() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'collaborator' &&
        projectData.collaborators is list &&
        projectData.collaborators.hasAny([request.auth.uid]);
    }

    // Users can read/update their own profile, approved users can read others
    // Approved users can also approve other users (update isApproved field)
    match /users/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isApprovedUser());
      allow write: if request.auth != null && request.auth.uid == userId;
      allow update: if isApprovedUser() &&
      	request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isApproved', 'approvedAt', 'userType', 'updatedAt']);
    }

    match /projects/{projectId} {
      // Creation is member-only — the UI already hides project creation from
      // collaborators (ProjectsTab.svelte), this makes it a real boundary.
      allow create: if isMember();
      allow read, write, delete: if isMember() || isCollaboratorOnProject(resource.data);

      match /nodes/{nodeId} {
        allow read, write, create, delete: if isMember() ||
          isCollaboratorOnProject(get(/databases/$(database)/documents/projects/$(projectId)).data);
      }

      match /edges/{edgeId} {
        allow read, write, create, delete: if isMember() ||
          isCollaboratorOnProject(get(/databases/$(database)/documents/projects/$(projectId)).data);
      }
    }

    match /recycle-bin/{projectId} {
    	allow read, write, create, delete: if isApprovedUser();

    	// Allow access to subcollections within recycle-bin projects
    	match /{document=**} {
      	allow read, write, create, delete: if isApprovedUser();
    	}
  	}

    // Global tasks collection
    match /tasks/{taskId} {
      allow read, write, create, delete: if isApprovedUser();
    }

    // Global timeline collection
    match /timeline/{eventId} {
      allow read, write, create, delete: if isApprovedUser();
    }
  }
}
