# Service Mode Configuration
# Set to 'firebase' to use Firebase services, 'local' to use localStorage
VITE_SERVICE_MODE=firebase

# Firebase Configuration (only needed when VITE_SERVICE_MODE=firebase)
VITE_FIREBASE_API_KEY=demo
VITE_FIREBASE_AUTH_DOMAIN=demo-borg.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-borg
VITE_FIREBASE_STORAGE_BUCKET=demo-borg.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=demo-borg
VITE_FIREBASE_APP_ID=demo-borg
VITE_FIREBASE_MEASUREMENT_ID=demo-borg

# Research library: private server settings, never prefix these with VITE_.
# The API URL includes /api. Use a Grist key with read access to this document.
GRIST_API_URL=https://grist.example.com/api
GRIST_API_KEY=
GRIST_RESEARCH_DOC_ID=eTx4r1u2Ssnj
GRIST_RESEARCH_TABLE_ID=Table1

# Saved Python UMAP coordinates; same dedicated token as the ingestion server.
RESEARCH_MAP_URL=https://mac.cyborglab.org/research-map
RESEARCH_MAP_TOKEN=

# Web paper submissions: private write credential, separate from map read access.
RESEARCH_INGEST_URL=https://mac.cyborglab.org/research-submit
RESEARCH_INGEST_TOKEN=

# Outline project notes (server-only)
OUTLINE_API_URL=https://wiki.cyborglab.org
OUTLINE_API_TOKEN=

# Server-only project assistant (never use a VITE_ prefix)
BORG_ASSISTANT_API_KEY=
BORG_ASSISTANT_MODEL=gpt-6-luna
